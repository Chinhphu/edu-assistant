<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. FORM VIEW: Nhật ký Tiết dạy -->
    <record id="view_class_journal_form" model="ir.ui.view">
        <field name="name">class.journal.form</field>
        <field name="model">class.journal</field>
        <field name="arch" type="xml">
            <form string="Nhật ký giảng dạy" class="o_form_view">
                <header>
                            <button name="action_process_and_upload" string="1. Upload lên YouTube" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                            <button name="action_fetch_transcript" string="2. Kéo phụ đề YouTube" type="object" class="oe_highlight" invisible="state != 'waiting_sub'"/>
                            <button name="action_analyze_ai" string="3. AI Phân tích" type="object" class="oe_highlight" invisible="state not in ('waiting_sub') or not raw_transcript"/>
                            <button name="action_lock_journal" string="Khóa Nhật Ký" type="object" class="btn-secondary" invisible="state == 'locked'" confirm="Bạn có chắc chắn muốn khóa dữ liệu này thành bằng chứng? Thao tác này không thể hoàn tác."/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,processing,waiting_sub,analyzed,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên Tiết Dạy"/>
                        <h1><field name="name" placeholder="VD: Tin học 3A1 - 24/08/2026"/></h1>
                    </div>

                    <group>
                        <!-- Cột trái: Thông tin cơ bản và Đầu vào -->
                        <group string="Thông tin Đầu vào">
                            <field name="class_id" options="{'no_create': True}" readonly="state == 'locked'"/>
                            <field name="date" readonly="state == 'locked'"/>
                            
                            <field name="audio_filename" invisible="1"/>
                            <field name="audio_file" filename="audio_filename" widget="binary" readonly="state != 'draft'"/>
                            <field name="cover_image" widget="image" options="{'size': [0, 90]}" readonly="state != 'draft'"/>
                        </group>
                        
                        <!-- Cột phải: Thông tin Đầu ra -->
                        <group string="Kết nối YouTube">
                            <field name="youtube_video_id"/>
                            <field name="youtube_url" widget="url" placeholder="https://youtube.com/watch?v=..."/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Tab 1: Danh sách hành vi -->
                        <page string="Chi tiết Hành vi (Bằng chứng)">
                            <field name="behavior_ids" readonly="state == 'locked'">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="behavior_type"/>
                                    <field name="display_time" placeholder="14:25"/>
                                    <field name="exact_quote"/>
                                    <field name="timestamp_seconds" column_invisible="True"/>
                                    <field name="video_url_at_time" widget="url" text="▶️ Xem ngay" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Tab 2: Phụ đề -->
                        <page string="Phụ đề gốc (Transcript)">
                            <field name="raw_transcript" placeholder="Phụ đề YouTube sẽ được kéo về đây..." readonly="state == 'locked'"/>
                        </page>

                    </notebook>
                </sheet>
                <!-- Chatter: Khung chat và lưu lịch sử -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 2. list VIEW: Danh sách Nhật ký -->
    <record id="view_class_journal_list" model="ir.ui.view">
        <field name="name">class.journal.list</field>
        <field name="model">class.journal</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="class_id"/>
                <!-- Thêm màu sắc cho các trạng thái mới -->
                <field name="state" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state in ('processing', 'waiting_sub')"
                       decoration-primary="state == 'analyzed'"
                       decoration-success="state == 'locked'" 
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 3. ACTION -->
    <record id="action_class_journal" model="ir.actions.act_window">
        <field name="name">Nhật ký Giảng dạy</field>
        <field name="res_model">class.journal</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. MENU ITEM -->
    <menuitem id="menu_class_journal" 
              name="Nhật ký Giảng dạy" 
              parent="school_core.menu_school_root" 
              action="action_class_journal" 
              sequence="5"/>
</odoo>